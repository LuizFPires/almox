# Almox — variáveis de ambiente. Copie para .env.local e preencha.
# Nunca coloque valores reais neste arquivo. Na Vercel, cadastre as mesmas chaves
# em Settings › Environment Variables (Preview = projeto dev, Production = projeto prod).

# --- Supabase ---------------------------------------------------------------
# Local: `npx supabase start` mostra a URL e as chaves.
# Nuvem: painel do projeto › Project Settings › API Keys.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54421
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Só no servidor (rotas de API, edge functions). Ignora RLS: nunca exponha ao navegador.
SUPABASE_SECRET_KEY=

# --- App ----------------------------------------------------------------------
# URL pública do app (links nos e-mails de aviso).
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Web Push (M9) --------------------------------------------------------------
# Gere com: npx web-push generate-vapid-keys
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:contato@exemplo.com.br

# --- E-mail transacional (M9) -------------------------------------------------
RESEND_API_KEY=
EMAIL_REMETENTE=Almox <avisos@exemplo.com.br>

# --- Monitoramento (M10) ------------------------------------------------------
SENTRY_DSN=

# --- Agente de impressão (M3) — ficam no mini PC, em agente-impressao/.env ------
# ALMOX_SUPABASE_URL=
# ALMOX_TOKEN_DISPOSITIVO=
