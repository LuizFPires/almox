# Copie para .env e cole os valores mostrados na tela Impressora do app
# (Cadastros › Impressora › Cadastrar mini PC). O token aparece uma única vez.
ALMOX_SUPABASE_URL=
ALMOX_CHAVE_PUBLICA=
ALMOX_TOKEN_DISPOSITIVO=

